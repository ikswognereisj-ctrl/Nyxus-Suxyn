webkit2gtk-4.1
gtk3
libayatana-appindicator
python-aiohttp
sqlite
nftables
python-sqlalchemy
python-click
python-structlog
python-yaml
libnotify

# ── INSTALLER ────────────────────────────────────────────────────────
# ★ THE FIX (2026-07-28): calamares is installed as a BINARY PACKAGE here,
# not built from the AUR in the chroot.
#
# Four ISOs shipped with no installer because customize_airootfs.sh tried to
# `makepkg` calamares inside the chroot, and that path kept breaking for a
# different reason each time - first an unanswerable `sudo` password prompt
# for the locked `nobody` user, then an empty chroot mirrorlist ("no servers
# configured for repository: extra"), so kpmcore + yaml-cpp were unreachable.
#
# None of that is necessary: calamares is a plain binary in [blackarch],
# which this profile's BUILD-TIME pacman.conf already enables, and both of its
# problem dependencies are in [extra]:
#     calamares -> blackarch      kpmcore -> extra      yaml-cpp -> extra
# pacstrap installs it directly, so the installer no longer depends on the
# chroot having working network, a build user, or a mirrorlist at all.
#
# The AUR `_aur_build calamares` call is left in place as a fallback - it
# early-returns when `pacman -Qi calamares` already succeeds, so it becomes a
# no-op rather than dead weight.
calamares

# ── desktop completeness (added 2026-08-03) ────────────────────────────
# Each of these closes a gap found by scripts/audit.sh item 8. They are
# small, and every one of them is the difference between a capability
# existing and a capability working.
# gnome-calculator : there was no calculator at all
# gnome-keyring    : saved wifi/passwords had nowhere to live, so the user
#                    got re-prompted for credentials on every login
# dex              : reads ~/.config/autostart, which shipped with nothing
#                    reading it — Settings wrote entries that never fired
gnome-keyring
dex

# ── personal information (added 2026-08-03) ────────────────────────────
# There was no mail client, no calendar and no contacts app of any kind.
# A daily driver that cannot do email is not a daily driver.
#
# thunderbird over evolution/geary/kmail/claws-mail: it handles Gmail and
# Outlook OAuth sign-in, which is the one thing that reliably defeats people
# on the alternatives, and it carries calendar and contacts itself so one
# package closes three gaps. evolution is the better Exchange/Outlook clone
# but is heavier; geary is prettier but has no calendar.
thunderbird

# Desktop-native calendar and contacts on top, sharing evolution-data-server
# so the quick-settings flyout can show real events later instead of an empty
# month grid (design/mockups/set-notifications.png).

# Clock, timers, alarms, world clocks — expected on every mainstream desktop.

# ── replaced by NYXUS apps (2026-08-03) ──────────────────────────────
# gnome-calculator       -> nyxus-calculator
# gnome-clocks           -> nyxus-clock
# gnome-calendar         -> nyxus-calendar
# gnome-contacts         -> thunderbird carries contacts; a NYXUS one can follow
# gnome-text-editor      -> nyxus-notepad
# loupe                  -> nyxus-viewer
# evolution-data-server  -> only existed for gnome-calendar/contacts
# gnome-keyring is KEPT on purpose: it is a daemon implementing the Secret
# Service API, not an app. There is no UI to theme, and credential storage
# is one of the few things worth not hand-rolling.

# ── archive support (2026-08-03) ─────────────────────────────────────
# bsdtar is what NYXUS Archive reads and writes with — one binary that handles
# zip, tar and every compressor, 7z, iso and rar, so there is no per-format
# special casing to get subtly wrong. It was present on the build box only as
# an implicit dependency, which is the "works on my machine" trap.
libarchive
# 7zip is already listed with the media/utility block above (line ~314); a
# second entry here was the standing `duplicate packages: 7zip` WARN. pacman
# tolerates the repeat, so nothing broke — but a warning nobody can ever clear
# is a warning nobody reads, and this file has two other real gates keyed off
# it. Listed once, near its first use.

# file-roller  -> nyxus-archive (2026-08-03)

grub-btrfs
# inotify-tools is a HARD runtime requirement of grub-btrfsd.service, which
# grub-btrfs ships and customize_airootfs.sh enables (`_nyx_enable
# grub-btrfsd.service`) — the daemon's ExecStart is a shell loop around
# `inotifywait` on the snapshot directory. It was never listed, so on the
# 2026-08-17 ISO the unit was enabled and could never start: the live-VM audit
# found no `inotifywait` binary and grub-btrfsd failing at every boot. Not
# optional and not a nicety — without it the btrfs rollback entry only ever
# appears on the next kernel update, never when a snapshot is taken.
inotify-tools
libreoffice-fresh
