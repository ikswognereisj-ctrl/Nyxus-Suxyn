    // Every control on one page, in page order.
    function forKey(key) {
        var out = [];
        for (var i = 0; i < index.controls.length; ++i)
            if (index.controls[i].key === key)
                out.push(index.controls[i]);
        return out;
    }

    readonly property int controlCount: index.controls.length
