          label: qsTranslate("SetPageAppearance", "FOLLOW MUSIC"),
          sub: qsTranslate("SetPageAppearance", "Beat from the playing sink — window rims and filaments") },
        { key: "appearance", kind: "control",
          label: qsTranslate("SetPageAppearance", "MUSIC VISUALISER"),
          sub: qsTranslate("SetPageAppearance", "The bar turns over into a full-width spectrum while audio is playing") },
        { key: "appearance", kind: "control",
          label: qsTranslate("SetPageAppearance", "SYNCED LYRICS"),
          sub: qsTranslate("SetPageAppearance", "Off — nothing leaves this machine. Turning it on sends the artist, title and length of what you are playing to lrclib.net to look up timed lyrics, and nothing else.") },
