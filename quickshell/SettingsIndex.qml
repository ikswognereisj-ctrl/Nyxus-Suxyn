        { key: "appearance", kind: "section",
          label: qsTranslate("SetPageAppearance", "Theme"),
          sub: qsTranslate("SetPageAppearance", "Two complete themes. ICE is glacier living paint, plum, and Starlight. MAGMA is magma-to-black dye, the same Starlight sky, and the lava world as its own layer — not a photo of the two flattened together.") },
        { key: "appearance", kind: "control",
