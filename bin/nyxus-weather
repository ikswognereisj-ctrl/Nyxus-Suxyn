#!/usr/bin/env bash
# Nyxus Suxyn — raise glass Weather. Never GTK nyxus_weather.py.
set -u
if ! command -v qs >/dev/null 2>&1; then
  echo "Weather needs the desktop shell (qs)." >&2
  exit 2
fi
out="$(qs ipc call weather engage 2>&1)" || true
if [[ "${out}" == *"Target not found."* ]]; then
  out="$(qs ipc call nyxus weather 2>&1)" || true
fi
if [[ "${out}" == *"Target not found."* ]]; then
  echo "Weather is not in the running shell." >&2
  printf '%s\n' "${out}" >&2
  exit 2
fi
printf '%s\n' "${out}"
exit 0
