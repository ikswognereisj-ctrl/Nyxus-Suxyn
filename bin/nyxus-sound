#!/usr/bin/env bash
# nyxus-sound — manage and trigger the NYXUS sound theme.
#
# All reads are local, no privileges required.
# `set-system-default` writes /etc/dconf/db/local.d/00-nyxus-sound and
# runs `dconf update`, which IS privileged → wrapped in pkexec
# (policy: com.nyxus.sound.policy).
#
# Per-user settings are written to gsettings (no pkexec).
#
# Usage:
#   nyxus-sound [--pitch N] [--ui-gain 0-100] EVENT
#                                        Play one event (login, lock, ui-press, …)
#   nyxus-sound [--pitch N] [--ui-gain 0-100] play EVENT
#                                        Same as the bare event form
#   nyxus-sound status                   Print theme + per-event state
#   nyxus-sound list                     List installed sound themes
#   nyxus-sound list-events              List installed WAV stems (15 Freedesktop + material)
#   nyxus-sound test                     Play service-login as a smoke test
#   nyxus-sound preview-all              Play every event with 600ms gap
#   nyxus-sound on|off|toggle            Master mute (~/.config/nyxus/sound.state)
#   nyxus-sound set-theme NAME           Set per-user sound theme (gsettings)
#   nyxus-sound set-volume 0..100        Per-user event volume (gsettings)
#   nyxus-sound enable-event NAME        Re-enable a single event
#   nyxus-sound disable-event NAME       Disable a single event (rename to .disabled)
#   nyxus-sound mute-events              Disable every NYXUS event at once
#   nyxus-sound unmute-events            Re-enable every NYXUS event
#   nyxus-sound set-system-default       (pkexec) Make NYXUS the system-wide default
#   nyxus-sound reset                    Restore defaults (theme=NYXUS, vol=80, all enabled)
#
# Hyprland and the shell call the bare form (`nyxus-sound login`). A first
# argument that is not a subcommand is an event. Missing events fail silent.
# `--pitch` is a playback ratio (0.70–1.40). Smaller controls pass a value
# slightly above 1. `--ui-gain` is an integer percent (0–100, default 100)
# multiplied onto family_volume so Settings ▸ Sound can sit under media
# without touching the PipeWire sink. Hyprland `nyxus-sound login` omits it.
# The glass family is nine events (TRK-1050 / TRK-1064): press/release/knock
# share one sample; arrive/notify/lock/unlock/battery/error are the same
# instrument at other notes.
#
# Exit: 0 ok, 2 bad args, 3 missing dep, 4 write denied.
set -euo pipefail

THEME_ROOT="/usr/share/sounds"
NYXUS_THEME_DIR="${THEME_ROOT}/nyxus"
EVENTS_DIR="${NYXUS_THEME_DIR}/stereo"
USER_OVERRIDE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sounds/nyxus/stereo"
GS_SCHEMA="org.gnome.desktop.sound"
VOL_FILE="${HOME}/.config/nyxus/sound-volume"
STATE_FILE="${HOME}/.config/nyxus/sound.state"
SYSDEF_HELPER="/usr/local/libexec/nyxus-sound-system-default"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_STEREO="${SCRIPT_DIR}/../../share/sounds/nyxus/stereo"
PITCH=1
UI_GAIN=100

while [[ $# -gt 0 ]]; do
  case "$1" in
    --pitch)
      PITCH="${2:-}"
      shift 2 || { echo "nyxus-sound: --pitch needs a number" >&2; exit 2; }
      [[ "${PITCH}" =~ ^[0-9]+([.][0-9]+)?$ ]] \
        || { echo "nyxus-sound: --pitch needs a number" >&2; exit 2; }
      PITCH="$(awk -v p="${PITCH}" 'BEGIN{
        if (p < 0.70) p = 0.70;
        if (p > 1.40) p = 1.40;
        printf "%.3f", p
      }')"
      ;;
    --ui-gain)
      UI_GAIN="${2:-}"
      shift 2 || { echo "nyxus-sound: --ui-gain needs an integer 0-100" >&2; exit 2; }
      [[ "${UI_GAIN}" =~ ^[0-9]+$ ]] \
        || { echo "nyxus-sound: --ui-gain needs an integer 0-100" >&2; exit 2; }
      UI_GAIN=$((10#$UI_GAIN))
      (( UI_GAIN >= 0 && UI_GAIN <= 100 )) \
        || { echo "nyxus-sound: --ui-gain needs an integer 0-100" >&2; exit 2; }
      ;;
    *)
      break
      ;;
  esac
done

# Cosmic / QML names → stereo stems. The 15 Freedesktop WAVs stay on disk
# (13r). Session events that have a glass-family member play that member.
canonical_event() {
  case "$1" in
    login|startup|boot)                    echo service-login ;;
    logout)                                echo service-logout ;;
    lock|ui-lock)                          echo ui-lock ;;
    unlock|ui-unlock)                      echo ui-unlock ;;
    notification|message|notify|ui-notify) echo ui-notify ;;
    battery-low|ui-battery)                echo ui-battery ;;
    alert|battery-critical|error|ui-error) echo ui-error ;;
    arrive|app-open|success|ui-arrive|ui-success)
                                           echo ui-arrive ;;
    screenshot)                            echo complete ;;
    plug)                                  echo power-plug ;;
    unplug)                                echo power-unplug ;;
    trash)                                 echo device-removed ;;
    audio-volume-change|volume)            echo audio-volume-change ;;
    press|tup|ui-press)                    echo ui-press ;;
    release|ui-release)                    echo ui-release ;;
    knock|bump|wall|ui-knock)              echo ui-knock ;;
    *)                                     echo "$1" ;;
  esac
}

# canberra-gtk-play only knows Freedesktop ids. Family stems map back.
canberra_id() {
  case "$(canonical_event "$1")" in
    ui-notify)  echo message ;;
    ui-lock)    echo screen-locked ;;
    ui-unlock)  echo screen-unlocked ;;
    ui-battery) echo dialog-warning ;;
    ui-error)   echo dialog-error ;;
    ui-arrive)  echo complete ;;
    ui-press|ui-release|ui-knock) echo audio-volume-change ;;
    *)          echo "$(canonical_event "$1")" ;;
  esac
}

sounds_on() {
  if [[ -r "${STATE_FILE}" ]]; then
    case "$(tr -d '[:space:]' < "${STATE_FILE}" | tr '[:upper:]' '[:lower:]')" in
      off|0|false|no|muted) return 1 ;;
    esac
  fi
  return 0
}

set_sound_state() {
  mkdir -p "${HOME}/.config/nyxus" 2>/dev/null || return 0
  printf '%s\n' "$1" > "${STATE_FILE}" 2>/dev/null || true
}

require() {
  command -v "$1" >/dev/null 2>&1 \
    || { echo "missing: $1" >&2; exit 3; }
}

# Read 0..100 volume from $VOL_FILE (default 80) and emit a paplay-style
# 0..65536 integer. paplay treats 65536 as 100% (no gain change).
read_pa_volume() {
  local pct=80
  if [[ -r "${VOL_FILE}" ]]; then
    local raw
    raw=$(<"${VOL_FILE}")
    if [[ "${raw}" =~ ^[0-9]+$ ]] && (( raw >= 0 && raw <= 100 )); then
      pct="${raw}"
    fi
  fi
  echo $(( pct * 65536 / 100 ))
}

# Resolve which file to play for an event:
#   1. user override .disabled  → silent (return 1)
#   2. user override .wav       → play that (canonical or given name)
#   3. system stereo/<canonical>.wav
#   4. profile stereo next to this script (airootfs copy on preview PATH)
#   5. else                     → return 2 (caller may try canberra)
resolve_event_file() {
  local name="$1"
  local canon
  canon="$(canonical_event "${name}")"
  local cand dir
  for cand in "${name}" "${canon}"; do
    [[ -n "${cand}" ]] || continue
    if [[ -f "${USER_OVERRIDE_DIR}/${cand}.disabled" ]]; then
      return 1
    fi
  done
  for dir in "${USER_OVERRIDE_DIR}" "${EVENTS_DIR}" "${SCRIPT_STEREO}"; do
    [[ -d "${dir}" ]] || continue
    for cand in "${canon}" "${name}"; do
      [[ -n "${cand}" ]] || continue
      if [[ -f "${dir}/${cand}.wav" ]]; then
        echo "${dir}/${cand}.wav"; return 0
      fi
    done
  done
  return 2
}

# Glass-family events sit under the user's slider. Same sample for
# press/release/knock; release is the faint one.
family_volume() {
  local vol="$1" canon="$2" scaled
  case "${canon}" in
    ui-press)   scaled=$(( vol * 38 / 100 )) ;;
    ui-release) scaled=$(( vol * 16 / 100 )) ;;
    ui-knock)   scaled=$(( vol * 32 / 100 )) ;;
    ui-arrive)  scaled=$(( vol * 42 / 100 )) ;;
    ui-notify)  scaled=$(( vol * 40 / 100 )) ;;
    ui-lock|ui-unlock) scaled=$(( vol * 36 / 100 )) ;;
    ui-battery) scaled=$(( vol * 38 / 100 )) ;;
    ui-error)   scaled=$(( vol * 44 / 100 )) ;;
    *)          scaled="${vol}" ;;
  esac
  echo $(( scaled * UI_GAIN / 100 ))
}

_pa_play() {
  local file="$1" vol="$2" name="$3"
  if awk -v p="${PITCH}" 'BEGIN{exit (p+0 == 1) ? 0 : 1}'; then
    paplay --volume="${vol}" --client-name="nyxus-sound" \
           --stream-name="${name}" "${file}" >/dev/null 2>&1 || return 0
    return 0
  fi
  if ! command -v ffmpeg >/dev/null 2>&1; then
    paplay --volume="${vol}" --client-name="nyxus-sound" \
           --stream-name="${name}" "${file}" >/dev/null 2>&1 || return 0
    return 0
  fi
  local rate=44100 newrate
  if command -v ffprobe >/dev/null 2>&1; then
    rate="$(ffprobe -v error -select_streams a:0 \
      -show_entries stream=sample_rate -of csv=p=0 "${file}" 2>/dev/null || echo 44100)"
  fi
  [[ "${rate}" =~ ^[0-9]+$ ]] || rate=44100
  newrate="$(awk -v r="${rate}" -v p="${PITCH}" 'BEGIN{printf "%d", r*p}')"
  ffmpeg -nostdin -hide_banner -v error -i "${file}" \
    -af "asetrate=${newrate},aresample=${rate}" -f wav - \
    | paplay --volume="${vol}" --client-name="nyxus-sound" \
             --stream-name="${name}" >/dev/null 2>&1 || return 0
}

# Real volume-aware player. Uses paplay (PipeWire-pulse compat) so the
# user's slider value genuinely scales playback gain. Falls back to
# canberra-gtk-play if paplay is unavailable. Event plays fail silent —
# Hyprland login/lock must not print "unknown command" or stall the session.
play_event() {
  local name="$1" file vol canon
  sounds_on || return 0
  canon="$(canonical_event "${name}")"
  if file=$(resolve_event_file "${name}"); then
    if command -v paplay >/dev/null 2>&1; then
      vol=$(family_volume "$(read_pa_volume)" "${canon}")
      (( vol < 1 )) && vol=1
      _pa_play "${file}" "${vol}" "${name}"
      return 0
    fi
  fi
  if command -v canberra-gtk-play >/dev/null 2>&1; then
    canberra-gtk-play -i "$(canberra_id "${name}")" \
      -V "NYXUS event: ${name}" >/dev/null 2>&1 || true
    return 0
  fi
  return 0
}

# Per-event enable state lives as files (symlinks/renames) on disk in
# the user override dir, mirroring the upstream files. This keeps the
# state machine boring and survives gsettings being unavailable.
list_events() {
  {
    find "${EVENTS_DIR}" -maxdepth 1 -type f -name '*.wav' \
      -printf '%f\n' 2>/dev/null
    if [[ -d "${SCRIPT_STEREO}" ]]; then
      find "${SCRIPT_STEREO}" -maxdepth 1 -type f -name '*.wav' \
        -printf '%f\n' 2>/dev/null
    fi
  } | sed 's/\.wav$//' | sort -u
}

cmd="${1:-status}"
shift || true

case "${cmd}" in
  status)
    require python3
    python3 - "${EVENTS_DIR}" "${USER_OVERRIDE_DIR}" "${GS_SCHEMA}" <<'PY'
import json, os, subprocess, sys
events_dir, user_dir, schema = sys.argv[1], sys.argv[2], sys.argv[3]
def gs(key, default=""):
    try:
        r = subprocess.run(["gsettings", "get", schema, key],
                           capture_output=True, text=True, timeout=2)
        if r.returncode == 0:
            return r.stdout.strip().strip("'")
    except Exception:
        pass
    return default
events = []
if os.path.isdir(events_dir):
    for fn in sorted(os.listdir(events_dir)):
        if fn.endswith(".wav") or fn.endswith(".disabled"):
            name = fn.rsplit(".", 1)[0]
            disabled_user = os.path.exists(
                os.path.join(user_dir, name + ".disabled"))
            events.append({"event": name, "disabled": disabled_user})
print(json.dumps({
    "events_dir":    events_dir,
    "user_dir":      user_dir,
    "current_theme": gs("theme-name", "(unset)"),
    "event_volume":  gs("event-sounds", "true"),
    "events":        events,
}, indent=2))
PY
    ;;
  list)
    find "${THEME_ROOT}" -maxdepth 2 -name index.theme \
      -printf '%h\n' 2>/dev/null | sed "s,^${THEME_ROOT}/,," | sort
    ;;
  list-events)
    list_events
    ;;
  play)
    name="${1:?usage: play EVENT}"
    play_event "${name}"
    ;;
  on)
    set_sound_state on
    echo on
    ;;
  off)
    set_sound_state off
    echo off
    ;;
  toggle)
    if sounds_on; then
      set_sound_state off
      echo off
    else
      set_sound_state on
      echo on
    fi
    ;;
  test)
    play_event "service-login"
    ;;
  preview-all)
    while read -r evt; do
      [[ -n "${evt}" ]] || continue
      play_event "${evt}" || true
      sleep 0.6
    done < <(list_events)
    ;;
  set-theme)
    name="${1:?usage: set-theme NAME}"
    [[ -d "${THEME_ROOT}/${name}" ]] \
      || { echo "no such theme: ${name}" >&2; exit 2; }
    require gsettings
    gsettings set "${GS_SCHEMA}" theme-name "${name}"
    echo "per-user sound theme → ${name}"
    ;;
  set-volume)
    pct="${1:?usage: set-volume 0..100}"
    [[ "${pct}" =~ ^[0-9]+$ ]] && (( pct >= 0 && pct <= 100 )) \
      || { echo "volume must be 0..100" >&2; exit 2; }
    require gsettings
    # 0 → mute event sounds entirely, otherwise enable + leave volume to
    # the audio server (gsettings doesn't expose a per-event multiplier
    # in the legacy schema; we honour the boolean here).
    if (( pct == 0 )); then
      gsettings set "${GS_SCHEMA}" event-sounds false
    else
      gsettings set "${GS_SCHEMA}" event-sounds true
    fi
    # Also store the numeric value in our own dconf path for the
    # SoundsPage to display.
    gsettings set org.gnome.desktop.sound input-feedback-sounds true 2>/dev/null || true
    mkdir -p "${HOME}/.config/nyxus"
    echo "${pct}" > "${HOME}/.config/nyxus/sound-volume"
    echo "event volume → ${pct}%"
    ;;
  enable-event)
    name="${1:?usage: enable-event NAME}"
    mkdir -p "${USER_OVERRIDE_DIR}"
    rm -f -- "${USER_OVERRIDE_DIR}/${name}.disabled"
    echo "enabled: ${name}"
    ;;
  disable-event)
    name="${1:?usage: disable-event NAME}"
    [[ -f "${EVENTS_DIR}/${name}.wav" ]] \
      || { echo "no such event: ${name}" >&2; exit 2; }
    mkdir -p "${USER_OVERRIDE_DIR}"
    # An empty .disabled file in the user override path takes priority
    # over the system .wav per the freedesktop sound-theme spec.
    : > "${USER_OVERRIDE_DIR}/${name}.disabled"
    echo "disabled: ${name}"
    ;;
  mute-events)
    mkdir -p "${USER_OVERRIDE_DIR}"
    while read -r evt; do
      [[ -n "${evt}" ]] || continue
      : > "${USER_OVERRIDE_DIR}/${evt}.disabled"
    done < <(list_events)
    echo "all NYXUS events muted (per-user override)"
    ;;
  unmute-events)
    if [[ -d "${USER_OVERRIDE_DIR}" ]]; then
      find "${USER_OVERRIDE_DIR}" -maxdepth 1 -name '*.disabled' -delete
    fi
    echo "all NYXUS events unmuted"
    ;;
  set-system-default)
    [[ -x "${SYSDEF_HELPER}" ]] \
      || { echo "missing: ${SYSDEF_HELPER}" >&2; exit 3; }
    # polkit policy com.nyxus.sound.set-system-default targets exactly
    # this binary path — no shell, no arguments, no env injection.
    pkexec "${SYSDEF_HELPER}" || exit 4
    ;;
  reset)
    require gsettings
    gsettings set "${GS_SCHEMA}" theme-name "nyxus"
    gsettings set "${GS_SCHEMA}" event-sounds true
    if [[ -d "${USER_OVERRIDE_DIR}" ]]; then
      find "${USER_OVERRIDE_DIR}" -maxdepth 1 -name '*.disabled' -delete
    fi
    mkdir -p "${HOME}/.config/nyxus"
    echo "80" > "${HOME}/.config/nyxus/sound-volume"
    echo "sound settings reset to NYXUS defaults"
    ;;
  -h|--help|help)
    sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//;/^set -euo/d'
    ;;
  *)
    # Bare event: `nyxus-sound login` / `nyxus-sound ui-press`.
    # Missing WAVs fail silent — do not print "unknown command" (TRK-986).
    play_event "${cmd}"
    exit 0
    ;;
esac
