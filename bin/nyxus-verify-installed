#!/usr/bin/env bash
# nyxus-verify-installed — post-update self-check for an installed Nyxus Suxyn
# box (TRK-1282 placeholder for CS-1053 / dispatch TRK-1081 "post-update
# self-check + automatic rollback").
#
# THIS IS THE MINIMUM, NOT THE FEATURE. It answers four questions after
# `nyxus update` (or after any pacman transaction that touched a nyxus-*
# package — /etc/pacman.d/hooks/90-nyxus-verify.hook calls it with --hook):
#   1. is greetd enabled (the login path), and is its config present?
#   2. is `qs` (quickshell) installed, and does the session have a shell
#      config to run — the package copy /usr/share/nyxus/shell or the skel
#      seed /etc/skel/.config/quickshell?
#   3. does that shell config PARSE — qmllint (Qt 6) on shell.qml when a
#      linter is installed; otherwise a brace/bracket balance pass, which is
#      honest about what it is (a parse check, not a run);
#   4. is the [nyxus] channel configured, and are the nyxus-* packages
#      installed and consistent (same pkgver across the four)?
# It prints one line per check, exits 1 when a check FAILED, 0 otherwise.
# It never rolls back, never restarts anything, never writes. The nested
# greeter/compositor/shell start + ipc ping + snapper-default-on-fail is the
# work of CS-1053 and is recorded as such in CHECKLIST (TRK-1282 row).
#
# Exit codes: 0 all OK (WARNs allowed), 1 at least one FAIL, 2 usage.
set -uo pipefail

HOOK=0
QUIET=0
while (( $# )); do
  case "$1" in
    --hook)  HOOK=1 ;;
    --quiet) QUIET=1 ;;
    -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'nyxus-verify-installed: unknown argument %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

FAILS=0
ok()   { (( QUIET )) || printf '[ OK ] %s\n' "$*"; }
warn() { (( QUIET )) || printf '[WARN] %s\n' "$*"; }
bad()  { printf '[FAIL] %s\n' "$*"; FAILS=$((FAILS + 1)); }

# 1 ─ login path
if command -v systemctl >/dev/null 2>&1; then
  if systemctl is-enabled greetd.service >/dev/null 2>&1; then
    ok "greetd.service is enabled"
  else
    bad "greetd.service is NOT enabled — the machine would boot to a TTY"
  fi
else
  warn "systemctl not available — unit state not checked"
fi
if [[ -f /etc/greetd/config.toml ]]; then
  ok "/etc/greetd/config.toml present"
else
  bad "/etc/greetd/config.toml is missing"
fi

# 2 ─ the shell and its config
if command -v qs >/dev/null 2>&1; then
  ok "qs (quickshell) on PATH: $(qs --version 2>/dev/null | head -1 || echo '?')"
else
  bad "qs (quickshell) is not installed — no desktop shell"
fi
SHELL_QML=""
for _c in /usr/share/nyxus/shell/shell.qml /etc/skel/.config/quickshell/shell.qml; do
  [[ -f "${_c}" ]] && { SHELL_QML="${_c}"; break; }
done
if [[ -n "${SHELL_QML}" ]]; then
  ok "shell config: ${SHELL_QML}"
else
  bad "no shell.qml under /usr/share/nyxus/shell or /etc/skel/.config/quickshell"
fi

# 3 ─ does it parse
if [[ -n "${SHELL_QML}" ]]; then
  _lint=""
  for _l in /usr/lib/qt6/bin/qmllint qmllint6 qmllint-qt6; do
    command -v "${_l}" >/dev/null 2>&1 && { _lint="${_l}"; break; }
  done
  if [[ -n "${_lint}" ]]; then
    # Quickshell modules are not in qmllint's import path on most hosts; only
    # a SYNTAX error (not "unknown import") counts here.
    _out="$("${_lint}" "${SHELL_QML}" 2>&1)"; _lrc=$?
    if (( _lrc == 0 )) || ! printf '%s' "${_out}" | grep -qiE 'syntax error|unexpected token|expected token'; then
      ok "shell.qml has no syntax error (${_lint##*/})"
    else
      bad "shell.qml has a SYNTAX error (${_lint##*/}): $(printf '%s' "${_out}" | grep -iE 'syntax error|unexpected token|expected token' | head -1)"
    fi
  else
    _bal="$(python3 - "${SHELL_QML}" <<'PY'
import sys, re
src = open(sys.argv[1], encoding="utf-8", errors="replace").read()
src = re.sub(r"//[^\n]*", "", src)
src = re.sub(r"/\*.*?\*/", "", src, flags=re.S)
src = re.sub(r'"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'|`(?:\\.|[^`\\])*`', '""', src, flags=re.S)
pairs = {"{": "}", "[": "]", "(": ")"}
stack = []
for ch in src:
    if ch in pairs: stack.append(ch)
    elif ch in pairs.values():
        if not stack or pairs[stack.pop()] != ch:
            print("UNBALANCED"); sys.exit(0)
print("OK" if not stack else "UNBALANCED")
PY
)"
    if [[ "${_bal}" == "OK" ]]; then
      ok "shell.qml braces/brackets balance (no qmllint on this host — balance pass only)"
    else
      bad "shell.qml braces/brackets do NOT balance — the shell will not load"
    fi
  fi
fi

# 4 ─ the channel and the nyxus-* packages
if grep -qE '^\[nyxus\]' /etc/pacman.conf 2>/dev/null; then
  ok "[nyxus] channel is configured in /etc/pacman.conf"
else
  warn "no [nyxus] channel in /etc/pacman.conf — NYXUS packages ride the ISO (owner hosting decision, TRK-1281)"
fi
if command -v pacman >/dev/null 2>&1; then
  _vers=()
  _missing=()
  for _p in nyxus-shell nyxus-scripts nyxus-theme nyxus-system; do
    _v="$(pacman -Q "${_p}" 2>/dev/null | awk '{print $2}')"
    if [[ -n "${_v}" ]]; then _vers+=("${_v}"); else _missing+=("${_p}"); fi
  done
  if (( ${#_missing[@]} == 4 )); then
    warn "no nyxus-* packages installed (ISO-staged system, not yet on the channel)"
  else
    (( ${#_missing[@]} )) && warn "nyxus-* packages missing: ${_missing[*]}"
    _uniq="$(printf '%s\n' "${_vers[@]}" | sort -u | wc -l)"
    if (( _uniq == 1 )); then
      ok "nyxus-* packages installed at one version: ${_vers[0]}"
    else
      bad "nyxus-* packages at MIXED versions: $(printf '%s ' "${_vers[@]}")— a half-applied channel update"
    fi
  fi
fi

if (( FAILS )); then
  printf 'nyxus-verify-installed: %s check(s) FAILED%s\n' "${FAILS}" "$( (( HOOK )) && printf ' (pacman hook — transaction already committed; the pre-update snapshot is the rollback)' )" >&2
  # A hook must never abort pacman's PostTransaction; the verdict is printed.
  (( HOOK )) && exit 0
  exit 1
fi
ok "nyxus-verify-installed: all checks passed (placeholder scope — full self-check is CS-1053)"
exit 0
