#!/usr/bin/env bash
# Nyxus Suxyn — raise glass Reader. Never GTK nyxus_reader.py.
set -u
if ! command -v qs >/dev/null 2>&1; then
  echo "Reader needs the desktop shell (qs)." >&2
  exit 2
fi
if [[ -n "${1:-}" ]]; then
  out="$(qs ipc call reader at "$1" 2>&1)" || true
else
  out="$(qs ipc call reader engage 2>&1)" || true
fi
if [[ "${out}" == *"Target not found."* ]]; then
  out="$(qs ipc call nyxus reader 2>&1)" || true
fi
if [[ "${out}" == *"Target not found."* ]]; then
  echo "Reader is not in the running shell." >&2
  printf '%s\n' "${out}" >&2
  exit 2
fi
printf '%s\n' "${out}"
exit 0
