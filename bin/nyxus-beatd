#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
# nyxus-beatd   ·   rev 2026-07-07 r1 (Signature)
#
# Audio-reactive border daemon — the prism ring around the focused
# window rotates WITH THE MUSIC. cava (raw mode, 8 bars @ 30fps)
# feeds bass energy; every detected beat swings the border gradient
# angle forward, so the ring spins in time and rests in silence.
#
# The gradient colors are never touched (accent engine owns those) —
# only the trailing NNNdeg angle is rewritten, and the original
# border is restored exactly on exit.
#
# (r2) coexists with nyxus-tintd: if the per-app tint daemon has
# published colors in $XDG_RUNTIME_DIR/nyxus-border-colors, each spin
# uses THOSE stops instead of the startup snapshot — beat keeps the
# angle, tint keeps the colors, nobody stomps anybody.
#
# Not run directly — use `nyxus-beat on|off|toggle`.
# © 2026 JOSEPH A. SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
# ════════════════════════════════════════════════════════════════════
set -u
export PATH="${HOME}/.local/bin:${PATH}"

CAVA_CONF="${HOME}/.config/nyxus/cava-beat.conf"
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/nyxus-beatd.pid"
COLORFILE="${XDG_RUNTIME_DIR:-/tmp}/nyxus-border-colors"   # tintd handoff

command -v cava >/dev/null || { echo "beatd: cava not installed" >&2; exit 1; }

# single instance
if [[ -r "${PIDFILE}" ]] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
  echo "beatd: already running" >&2
  exit 0
fi
echo $$ > "${PIDFILE}"

BASE="$(hyprctl getoption general:col.active_border -j 2>/dev/null | jq -r '.custom // empty')"
[[ -z "${BASE}" ]] && BASE="rgba(ae206cff) rgba(0aa2d6ff) rgba(521e72ff) rgba(9b621bff) 270deg"

# getoption reports colors as bare argb hex ("fffe42ae"), which the
# keyword parser REJECTS — every color token must go back 0x-prefixed.
NORM=""
for tok in ${BASE}; do
  if [[ "${tok}" =~ ^[0-9a-fA-F]{8}$ ]]; then
    NORM+="0x${tok} "
  else
    NORM+="${tok} "
  fi
done
BASE="${NORM% }"

restore() {
  # children first, so no in-flight beat respins after the restore.
  # if tintd is live, hand its colors back with the resting angle;
  # otherwise restore the exact startup snapshot.
  pkill -P $$ 2>/dev/null
  local cols="${BASE% *}"
  [[ -r "${COLORFILE}" ]] && cols="$(<"${COLORFILE}")"
  hyprctl keyword general:col.active_border "${cols} ${BASE##* }" >/dev/null 2>&1
  rm -f "${PIDFILE}"
}
trap restore EXIT INT TERM

COLORS="${BASE% *}"                 # everything before the trailing angle
ANGLE="${BASE##* }"; ANGLE="${ANGLE%deg}"
[[ "${ANGLE}" =~ ^[0-9]+$ ]] || ANGLE=270

# ── RE-READING THE STOCK BORDER ───────────────────────────── TRK-4134 ──
# BASE is snapshotted ONCE, at startup, and that was fine while this only
# ever ran from a keybind you pressed after the desktop had settled. It is
# not fine now that it starts at login (see `restore` in nyxus-beat): at
# that moment the theme tools may not have painted yet, so the snapshot is
# whatever Hyprland booted with.
#
# Worse, it stranded the ICE/MAGMA switch. Flip the look while this daemon
# is up and the border keeps spinning the OLD theme's colours for the rest
# of the session, because COLORS was read before the flip and never again.
#
# So re-read the live colours when coming back from a silence, which is
# the same trick nyxus-pulse.sh uses (`read_stock` on a burst from zero)
# and for the same reason: silence is the one moment the border is
# guaranteed to be sitting at whatever the theme wants, not at something
# we spun it to.
#
# ⚠ COLOURS ONLY — never the angle. By the time we re-read, the angle on
# the wire is one WE rotated. Taking it back as the resting angle would
# ratchet 45° per silence and the restore trap would hand back a border
# the theme never set.
restock() {
  local live norm tok
  live="$(hyprctl getoption general:col.active_border -j 2>/dev/null \
          | jq -r '.custom // empty')"
  [[ -z "${live}" ]] && return
  norm=""
  for tok in ${live% *}; do
    if [[ "${tok}" =~ ^[0-9a-fA-F]{8}$ ]]; then
      norm+="0x${tok} "
    else
      norm+="${tok} "
    fi
  done
  [[ -n "${norm}" ]] && COLORS="${norm% }"
}

# beat detection over the two lowest bars: exponential moving average
# baseline; a frame beats when bass > 1.35x EMA, above an absolute
# floor, with a 180ms refractory window.
# (r2) pipeline is backgrounded + wait'ed: a foreground pipeline makes
# bash defer the TERM trap until the pipe exits, so `nyxus-beat off`
# would never restore. `wait` is signal-interruptible.
cava -p "${CAVA_CONF}" 2>/dev/null | {
  ema=10; last_beat=0; last_stock=0
  while IFS=';' read -r b1 b2 _; do
    [[ "${b1}" =~ ^[0-9]+$ && "${b2}" =~ ^[0-9]+$ ]] || continue
    bass=$(( (b1 + b2) / 2 ))
    ema=$(( (ema * 85 + bass * 15) / 100 ))
    now=$(( $(date +%s%3N) ))
    if (( bass > 25 && bass * 100 > ema * 135 && now - last_beat > 180 )); then
      # TRK-4134 · pick up a theme flip.
      #
      # ⚠ The first cut gated this on "first beat after two seconds of
      # quiet", copying nyxus-pulse.sh's burst-from-silence trick. Tested
      # by flipping the border to ICE colours mid-track: it never took,
      # because with music actually playing the beats land every few
      # hundred ms and a two-second gap never arrives. The one case the
      # gate covered was the one case that does not matter.
      #
      # So it is a plain interval instead. One `hyprctl getoption` every
      # three seconds, and only on a frame that already beat.
      if (( now - last_stock > 3000 )); then
        restock
        last_stock=${now}
      fi
      last_beat=${now}
      ANGLE=$(( (ANGLE + 45) % 360 ))
      [[ -r "${COLORFILE}" ]] && COLORS="$(<"${COLORFILE}")"   # tintd handoff
      hyprctl keyword general:col.active_border \
        "${COLORS} ${ANGLE}deg" >/dev/null 2>&1
    fi
  done
} &
wait $!
