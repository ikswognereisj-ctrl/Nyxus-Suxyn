#!/usr/bin/env bash
# Nyxus Suxyn — raise glass Archive. Never GTK nyxus_archive.py.
set -u
if ! command -v qs >/dev/null 2>&1; then
  echo "Archive needs the desktop shell (qs)." >&2
  exit 2
fi
if [[ -n "${1:-}" ]]; then
  out="$(qs ipc call archive at "$1" 2>&1)" || true
else
  out="$(qs ipc call archive engage 2>&1)" || true
fi
if [[ "${out}" == *"Target not found."* ]]; then
  out="$(qs ipc call nyxus archive 2>&1)" || true
fi
if [[ "${out}" == *"Target not found."* ]]; then
  echo "Archive is not in the running shell." >&2
  printf '%s\n' "${out}" >&2
  exit 2
fi
printf '%s\n' "${out}"
exit 0
