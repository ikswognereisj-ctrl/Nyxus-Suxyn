#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
# nyxus-beat <on|off|toggle|status>   ·   rev 2026-07-07 r1 (Signature)
# Front door for the audio-reactive border daemon (nyxus-beatd).
# Bound: Super+Alt+B ("beat"). Quicksettings-friendly.
# © 2026 JOSEPH A. SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
# ════════════════════════════════════════════════════════════════════
set -u
export PATH="${HOME}/.local/bin:${PATH}"
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/nyxus-beatd.pid"

# ── REMEMBERING (TRK-4134) ──────────────────────────────────────────
# Owner, 2026-09-14: "i havent seen the borders or edges pulsating to the
# real beat of the music ... i havent seen that happen in quit some time".
#
# He had not, and it was not a regression in the effect — the effect works.
# This front door was bound to Super+Alt+B and to nothing else. No
# exec-once anywhere started it, and nothing wrote down whether it had ever
# been on. So it lasted exactly as long as the session you pressed the key
# in, and every login came up with a still border.
#
# That also fails the standing "must survive logouts and reboots" rule, so
# the state goes on disk and `restore` reads it at login.
#
# NOT settings.json: SettingsStore owns that file and flushes writes it did
# not make, so a shell tool writing there is overwritten on the next save.
# ~/.local/state is where the other shell-side tools keep their runtime
# state and it is the correct XDG home for it.
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/nyxus"
STATE="${STATE_DIR}/beat-border"

remember() { mkdir -p "${STATE_DIR}" 2>/dev/null; printf '%s\n' "$1" >"${STATE}"; }

running() { [[ -r "${PIDFILE}" ]] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; }

start() {
  running && { echo "beat: already on"; return; }
  nohup nyxus-beatd >/dev/null 2>&1 &
  notify-send -u low -t 2200 "◤ NYXUS ◥ BEAT" "border ring is listening" 2>/dev/null
  echo "beat: on"
}

stop() {
  running || { echo "beat: already off"; return; }
  local pid; pid="$(cat "${PIDFILE}")"
  # bash defers the TERM trap while it waits on the cava pipeline, so
  # signal the children first — cava's exit unblocks the daemon, which
  # then runs its restore trap and exits.
  pkill -P "${pid}" 2>/dev/null
  kill "${pid}" 2>/dev/null
  notify-send -u low -t 2200 "◤ NYXUS ◥ BEAT" "border ring at rest" 2>/dev/null
  echo "beat: off"
}

case "${1:-toggle}" in
  on)     remember on;  start ;;
  off)    remember off; stop ;;
  toggle) if running; then remember off; stop; else remember on; start; fi ;;
  # `restore` is what exec-once calls: honour the remembered choice and say
  # nothing either way. ON is the default for a fresh install — this is a
  # signature effect and one nobody switches on is one nobody sees. It costs
  # a cava pipe and one hyprctl per detected beat, and it hands the border
  # back untouched the moment it stops.
  restore)
    want="on"
    [[ -r "${STATE}" ]] && want="$(<"${STATE}")"
    [[ "${want}" == "on" ]] && start >/dev/null
    exit 0 ;;
  status) running && echo on || echo off ;;
  *) echo "usage: nyxus-beat <on|off|toggle|restore|status>" >&2; exit 2 ;;
esac
