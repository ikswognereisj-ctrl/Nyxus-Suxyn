#!/usr/bin/env python3
"""Nyxus quiet hours — apply DND schedule with Settings closed."""
import json, os, re, subprocess
from datetime import datetime
from pathlib import Path

PREFS = Path.home() / ".config" / "nyxus" / "settings.json"
STATE = Path.home() / ".config" / "nyxus" / "quiet-hours.state"
DUNST = Path.home() / ".config" / "dunst" / "nyxus-priority.conf"
MAKO = Path.home() / ".config" / "mako" / "nyxus-priority"

def sh(argv):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=3)
        return p.returncode, p.stdout or ""
    except Exception:
        return 1, ""

def load_block():
    try:
        raw = json.loads(PREFS.read_text(encoding="utf-8"))
    except Exception:
        return {}
    n = raw.get("notifications")
    return n if isinstance(n, dict) else {}

def norm(text):
    m = re.fullmatch(r"\s*(\d{1,2}):(\d{2})\s*", text or "")
    if not m:
        return ""
    h, mi = int(m.group(1)), int(m.group(2))
    if not (0 <= h <= 23 and 0 <= mi <= 59):
        return ""
    return f"{h:02d}:{mi:02d}"

def in_window(start, end):
    s, e = norm(start), norm(end)
    if not s or not e or s == e:
        return False
    now = datetime.now()
    cur = now.hour * 60 + now.minute
    a = int(s[:2]) * 60 + int(s[3:5])
    b = int(e[:2]) * 60 + int(e[3:5])
    if a < b:
        return a <= cur < b
    return cur >= a or cur < b

def st_load():
    try:
        st = json.loads(STATE.read_text(encoding="utf-8"))
        if isinstance(st, dict):
            return st
    except Exception:
        pass
    return {"schedule_armed": False, "user_override": False}

def st_save(st):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(st, indent=2) + "\n", encoding="utf-8")

def daemon():
    for proc in ("mako", "dunst", "swaync"):
        rc, out = sh(["pgrep", "-x", proc])
        if rc == 0 and out.strip():
            return proc
    return ""

def dnd_get(d):
    if d == "mako":
        rc, out = sh(["makoctl", "mode"])
        return "do-not-disturb" in out
    if d == "dunst":
        rc, out = sh(["dunstctl", "is-paused"])
        return "true" in out.lower()
    if d == "swaync":
        rc, out = sh(["swaync-client", "-D"])
        return "true" in out.lower()
    return False

def dnd_set(d, on):
    if not d or dnd_get(d) == bool(on):
        return
    if d == "mako":
        sh(["makoctl", "mode", "-a" if on else "-r", "do-not-disturb"])
    elif d == "dunst":
        sh(["dunstctl", "set-paused", "true" if on else "false"])
    elif d == "swaync":
        sh(["swaync-client", "-d"])

def apply_bypass(n, d):
    names = n.get("priority")
    if names is None:
        names = ["Nyxus Clock"]
    elif not isinstance(names, list):
        names = [str(names).strip()] if str(names).strip() else ["Nyxus Clock"]
    names = [str(x).strip() for x in names if str(x).strip()]
    always = bool(n.get("alarms_always"))
    if d == "dunst":
        DUNST.parent.mkdir(parents=True, exist_ok=True)
        lines = ["# generated by nyxus-quiet-hours — do not edit\n"]
        if always:
            for i, app in enumerate(names):
                lines += [f"[nyxus_prio_{i}]\n",
                          f"    appname = {app}\n",
                          "    skip_pause = true\n\n"]
        DUNST.write_text("".join(lines), encoding="utf-8")
        rc_path = Path.home() / ".config" / "dunst" / "dunstrc"
        if rc_path.is_file():
            text = rc_path.read_text(encoding="utf-8")
            block = ("# BEGIN NYXUS-QUIET-HOURS\n"
                     f"include = {DUNST}\n"
                     "# END NYXUS-QUIET-HOURS\n")
            if "# BEGIN NYXUS-QUIET-HOURS" in text:
                text = re.sub(
                    r"# BEGIN NYXUS-QUIET-HOURS.*?# END NYXUS-QUIET-HOURS\n",
                    block, text, count=1, flags=re.S)
            else:
                text = text.rstrip() + "\n" + block
            rc_path.write_text(text, encoding="utf-8")
        sh(["dunstctl", "reload"])
    elif d == "mako":
        MAKO.parent.mkdir(parents=True, exist_ok=True)
        lines = ["# generated by nyxus-quiet-hours — do not edit\n"]
        if always:
            for app in names:
                q = app.replace('"', '\\"')
                lines += [f'[mode=do-not-disturb app-name="{q}"]\n',
                          "invisible=0\n\n"]
        MAKO.write_text("".join(lines), encoding="utf-8")
        cfg = Path.home() / ".config" / "mako" / "config"
        if cfg.is_file():
            text = cfg.read_text(encoding="utf-8")
            block = ("# BEGIN NYXUS-QUIET-HOURS\n"
                     f"include={MAKO}\n"
                     "# END NYXUS-QUIET-HOURS\n")
            if "# BEGIN NYXUS-QUIET-HOURS" in text:
                text = re.sub(
                    r"# BEGIN NYXUS-QUIET-HOURS.*?# END NYXUS-QUIET-HOURS\n",
                    block, text, count=1, flags=re.S)
            else:
                text = text.rstrip() + "\n" + block
            cfg.write_text(text, encoding="utf-8")
        sh(["makoctl", "reload"])

def main():
    n = load_block()
    d = daemon()
    apply_bypass(n, d)
    st = st_load()
    enabled = bool(n.get("quiet_hours"))
    if not enabled:
        if st.get("schedule_armed"):
            dnd_set(d, False)
        st["schedule_armed"] = False
        st["user_override"] = False
        st_save(st)
        return
    win = in_window(str(n.get("quiet_from", "22:00")),
                    str(n.get("quiet_to", "07:00")))
    if win:
        if not st.get("user_override"):
            if not dnd_get(d):
                dnd_set(d, True)
                st["schedule_armed"] = True
        st_save(st)
        return
    st["user_override"] = False
    if st.get("schedule_armed"):
        dnd_set(d, False)
        st["schedule_armed"] = False
    st_save(st)

if __name__ == "__main__":
    main()
