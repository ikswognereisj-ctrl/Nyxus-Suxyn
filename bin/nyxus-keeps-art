#!/usr/bin/env python3
"""NYXUS Suxyn — upgrade the album art on kept recordings.        audit 2026-09-08

The tape embeds whatever Chromium hands over MPRIS, and Chromium downscales
that to 120x120. On the Media app's full-bleed tiles it is a blur. This tool
walks `~/Music/NYXUS Keeps`, and for every FLAC whose attached cover is
smaller than 300 px (or missing) it asks the iTunes Search API for the song,
takes the 600x600 artwork, and re-muxes it in with ffmpeg. While it has the
answer it also fills an "Unknown album" tag with the real album name.

    nyxus-keeps-art                 sweep the whole library (resumable, idempotent)
    nyxus-keeps-art --file X.flac   one file (the tape calls this after a keep)
    nyxus-keeps-art --dry-run       report only

Only artist + title leave the machine. Misses are cached so an obscure track
is asked about once. Rate-limited to ~20 lookups a minute (iTunes' ceiling).
Never touches a file that already has a >=300 px cover. Failures are logged
to ~/.cache/nyxus/keeps-art.log and never raised — worst case is the old art.
"""
import difflib
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path.home()
KEEPS = HOME / "Music" / "NYXUS Keeps"
CACHE = HOME / ".cache" / "nyxus" / "keeps-art"
LOG = HOME / ".cache" / "nyxus" / "keeps-art.log"
MISSES = CACHE / "misses.json"
MIN_PX = 300
RATE_S = 3.2
UA = "nyxus-keeps-art/1 (+https://github.com/sierengowskisierengowski-cpu/Nyxus-Suxyn)"


def log(msg):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")


def probe(path):
    """(tags dict, cover width or 0)."""
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-print_format", "json",
             "-show_format", "-show_streams", str(path)],
            capture_output=True, text=True, timeout=30).stdout
        d = json.loads(out or "{}")
    except Exception as e:
        log(f"probe failed {path}: {e}")
        return {}, 0
    tags = {k.lower(): v for k, v in (d.get("format", {}).get("tags") or {}).items()}
    width = 0
    for s in d.get("streams", []):
        if s.get("codec_type") == "video":
            width = max(width, int(s.get("width") or 0))
    return tags, width


_JUNK = re.compile(r"\s*[\(\[][^\)\]]*[\)\]]|\s+(?:feat|ft)\.?\s.*$", re.I)
_SPLIT = re.compile(r"\s*(?:&|,|;|/|\bx\b|\bfeat\.?\b|\bft\.?\b|\bfeaturing\b|\bwith\b|\band\b)\s+", re.I)


def norm(s):
    return re.sub(r"[^a-z0-9]+", " ", (s or "").lower()).strip()


_DASH = re.compile(r"\s+[-–—]\s+")


def lookup(artist, title):
    """Best iTunes song match. Tries the MPRIS artist first; then, for
    channel uploads ("centbeats" / "50 Cent – BROKEN"), the artist named in
    the title; then a strict title-only search."""
    hit = _lookup(artist, title)
    if hit:
        return hit
    parts = _DASH.split(title or "", maxsplit=1)
    if len(parts) == 2 and 1 < len(parts[0]) < 60:
        hit = _lookup(parts[0], parts[1])
        if hit:
            return hit
    return _lookup("", title, strict=True)


def _lookup(artist, title, strict=False):
    lead = _SPLIT.split(artist or "", maxsplit=1)[0].strip()
    clean = _JUNK.sub("", title or "").strip(" -–—")
    # YouTube titles: 'T-Pain - "Booty" ft. X' -> 'Booty'
    if lead and clean.lower().startswith(lead.lower()):
        clean = re.sub(r"^\s*[-–—:|]\s*", "", clean[len(lead):]).strip()
    clean = clean.strip('"\'“”‘’ ')
    term = f"{lead} {clean}".strip()
    if not term:
        return None
    url = ("https://itunes.apple.com/search?" +
           urllib.parse.urlencode({"term": term, "entity": "song", "limit": 10}))
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=12) as r:
        res = json.load(r).get("results", [])
    best, best_score = None, 0.0
    for h in res:
        a = norm(h.get("artistName")); t = norm(h.get("trackName"))
        sa = difflib.SequenceMatcher(None, norm(lead), a).ratio()
        if norm(lead) and norm(lead) in a:
            sa = max(sa, 0.9)
        st = difflib.SequenceMatcher(None, norm(clean), t).ratio()
        if norm(clean) and norm(clean) in t:
            st = max(st, 0.9)
        score = st if strict or not norm(lead) else 0.45 * sa + 0.55 * st
        if score > best_score:
            best, best_score = h, score
    floor = 0.88 if (strict or not norm(lead)) else 0.72
    if not best or best_score < floor or not best.get("artworkUrl100"):
        return None
    art = best["artworkUrl100"].replace("100x100bb", "600x600bb")
    return {"art_url": art, "album": best.get("collectionName") or "",
            "artist": best.get("artistName") or "", "score": round(best_score, 2)}


def fetch(url):
    CACHE.mkdir(parents=True, exist_ok=True)
    p = CACHE / (hashlib.sha1(url.encode()).hexdigest() + ".jpg")
    if p.exists() and p.stat().st_size > 1000:
        return p
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=20) as r, open(p, "wb") as f:
        f.write(r.read())
    return p if p.stat().st_size > 1000 else None


def embed(path, art, album=None):
    tmp = path.with_suffix(".tmp.flac")
    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
           "-i", str(path), "-i", str(art),
           "-map", "0:a", "-map", "1:v", "-map_metadata", "0",
           "-c:a", "copy", "-c:v", "mjpeg", "-disposition:v", "attached_pic",
           "-metadata:s:v", "title=Album cover"]
    if album:
        cmd += ["-metadata", f"album={album}"]
    cmd += [str(tmp)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    if r.returncode != 0 or not tmp.exists() or tmp.stat().st_size < 1000:
        log(f"ffmpeg failed {path}: {r.stderr.strip()[:200]}")
        tmp.unlink(missing_ok=True)
        return False
    os.replace(tmp, path)
    return True


def load_misses():
    try:
        return json.load(open(MISSES))
    except Exception:
        return {}


def save_misses(m):
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = MISSES.with_suffix(".tmp")
    json.dump(m, open(tmp, "w"))
    os.replace(tmp, MISSES)


def process(path, misses, dry, last_call):
    tags, width = probe(path)
    if width >= MIN_PX:
        return "ok", last_call
    artist, title = tags.get("artist", ""), tags.get("title", "")
    if not title:
        return "notags", last_call
    key = f"{norm(artist)}|{norm(title)}"
    if key in misses and time.time() - misses[key] < 30 * 86400:
        return "miss-cached", last_call
    wait = RATE_S - (time.time() - last_call)
    if wait > 0:
        time.sleep(wait)
    try:
        hit = lookup(artist, title)
    except Exception as e:
        log(f"lookup failed {artist} - {title}: {e}")
        return "error", time.time()
    last_call = time.time()
    if not hit:
        misses[key] = time.time()
        return "miss", last_call
    album = None
    if (tags.get("album") or "").strip().lower() in ("", "unknown album") and hit["album"]:
        album = hit["album"]
    if dry:
        log(f"DRY {path.name}: {width}px -> {hit['art_url']} album={album!r} score={hit['score']}")
        return "would-fix", last_call
    try:
        art = fetch(hit["art_url"])
    except Exception as e:
        log(f"art download failed {path}: {e}")
        return "error", last_call
    if not art:
        return "error", last_call
    if embed(path, art, album):
        log(f"FIXED {path.relative_to(KEEPS)}: {width}px -> 600px" +
            (f", album -> {album}" if album else "") + f" (score {hit['score']})")
        return "fixed", last_call
    return "error", last_call


def main(argv):
    dry = "--dry-run" in argv
    files = []
    if "--file" in argv:
        files = [Path(argv[argv.index("--file") + 1])]
    else:
        files = sorted(KEEPS.rglob("*.flac"), key=lambda p: p.stat().st_mtime, reverse=True)
    misses = load_misses()
    counts = {}
    last_call = 0.0
    for i, p in enumerate(files):
        if not p.exists() or p.suffix != ".flac" or p.name.endswith(".tmp.flac"):
            continue
        st, last_call = process(p, misses, dry, last_call)
        counts[st] = counts.get(st, 0) + 1
        if i % 25 == 0:
            save_misses(misses)
    save_misses(misses)
    summary = " ".join(f"{k}={v}" for k, v in sorted(counts.items()))
    log(f"sweep done: {len(files)} files, {summary}")
    print(summary)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
