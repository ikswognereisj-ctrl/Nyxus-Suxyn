#!/usr/bin/env python3
"""
nyxus-portal-watch — "Sign in to this network", and nothing else.

★ THE PROBLEM, IN THE WORDS OF THE PERSON WHO HITS IT (`WIP-720`)

  Hotel, airport, campus and coffee-shop Wi-Fi all work the same way: the
  laptop associates, the bars fill in, DHCP hands out an address — and then
  every packet is dropped until you sign in on a web page nobody has shown
  you. Before this file, Suxyn's answer to that was silence. The Wi-Fi menu
  said connected, the browser said the site could not be reached, and the
  honest reading of that screen for someone who just switched from Windows
  is "Linux broke my Wi-Fi".

  NetworkManager already knew. It has reported PORTAL on D-Bus on every ISO
  this project has ever baked (see etc/NetworkManager/conf.d/99-nyxus.conf,
  which documents the check that produces it). Nothing listened. This
  listens.

★ WHAT IT DOES, AND THE THREE THINGS IT REFUSES TO DO

  It watches ONE D-Bus property — org.freedesktop.NetworkManager's
  `Connectivity` — and when it becomes PORTAL it raises one notification
  with one button. The button opens the connectivity-check URL in the
  browser; the portal intercepts that request and answers with its own
  login page, which is the same trick every other desktop uses and the
  reason no portal-detection API is needed.

  · It makes NO network request of its own. Not one. The only outbound
    traffic in this feature is NetworkManager's own check, which is
    documented and switchable in 99-nyxus.conf. A watcher that did its own
    polling would be a second undocumented request, which is the exact
    defect this row exists to close.
  · It NEVER opens a browser by itself. A page appearing unbidden is
    indistinguishable from malware. The person presses the button.
  · It does not nag. One notice per (connection, portal episode). Sit in a
    hotel lobby for six hours and you are told once, not seventy-two times.

★ WHY notify-send AND NOT A SECOND NOTIFICATION STYLE

  nyxus-hemera established the actioned-notice route in this build:
  `notify-send -A key=Label` implies --wait, so the process stays alive
  until the person clicks or dismisses and then prints the chosen key on
  stdout. That is how a button works without this script owning a D-Bus
  main loop of its own. Hemera's Review button, nyxus-update-check and the
  definitions prompt all use it. This uses it too, with the same shape, on
  purpose — a second notification style is how two parts of one desktop
  start looking like two products.

★ WHY A USER SERVICE AND NOT A DISPATCHER SCRIPT

  NetworkManager dispatcher scripts run as root, and root has no session,
  no browser and nobody to ask. The notification and the browser both
  belong to the person, so the watcher does too. It needs no Wayland
  handle — notify-send and xdg-open both speak the session bus, which the
  user manager already has — which is the same safety argument
  nyxus-crashd.service records for choosing default.target.

SURFACES
    nyxus-portal-watch              watch forever (the unit runs this)
    nyxus-portal-watch --once       report the state once and exit
    nyxus-portal-watch --json       machine-readable, for Settings ▸ Network
    nyxus-portal-watch --open       open the sign-in page now, no waiting

EXIT CODES
    0  did what it said
    1  NetworkManager could not be reached on the system bus
    2  usage

  `NYXUS_PORTAL_STATE` relocates the "already told them" marker. It exists
  so the proof harness can exercise this engine against a throwaway tree
  instead of a mock — the same confined-HOME pattern nyxus-hemera uses.

© 2026 JOSEPH A. SIERENGOWSKI · NYX-J5W-2026-SIERENGOWSKI-LOCKED
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

APP_NAME = "NYXUS"

# NMConnectivityState, from NetworkManager's own enum. Named rather than
# spelled as bare integers because `== 2` in a branch is unreadable and
# because gate 13q39 asserts the PORTAL constant by name.
NM_CONNECTIVITY_UNKNOWN = 0
NM_CONNECTIVITY_NONE = 1
NM_CONNECTIVITY_PORTAL = 2
NM_CONNECTIVITY_LIMITED = 3
NM_CONNECTIVITY_FULL = 4

STATE_WORDS = {
    NM_CONNECTIVITY_UNKNOWN: "unknown",
    NM_CONNECTIVITY_NONE: "no connection",
    NM_CONNECTIVITY_PORTAL: "sign-in required",
    NM_CONNECTIVITY_LIMITED: "connected, no internet",
    NM_CONNECTIVITY_FULL: "online",
}

NM_BUS = "org.freedesktop.NetworkManager"
NM_PATH = "/org/freedesktop/NetworkManager"

# The words on the notice, as constants — and the reason is a cross-file
# one. "Sign in to this network" is the phrase `WIP-720` was written around
# and the phrase a switcher recognises from Windows, and it also has to be
# the phrase on the Settings ▸ Network card, because somebody who swiped
# the notice away and went looking for it should find the thing they
# half-remember rather than a synonym. Gate 13q39 asserts BOTH: that this
# constant holds that phrase, and that the same phrase appears in
# nyxus_settings_pages_devices.py.
#
# ⚠ An earlier version of this comment claimed the gate pinned the label
#   when it did not — I wrote the comment while planning the gate and then
#   gated something else. AGENTS.md's line about `13q12` is "a comment that
#   satisfies the reader instead of the gate"; this was that, in my own
#   file. The check exists now. Do not weaken one without the other.
PORTAL_TITLE = "Sign in to this network"
PORTAL_BODY = (
    "This Wi-Fi needs you to sign in on a web page before it will carry "
    "any traffic. Your connection is fine — the network is waiting for you.")
PORTAL_ACTION_KEY = "signin"
PORTAL_ACTION_LABEL = "Sign in"


def state_path() -> Path:
    override = os.environ.get("NYXUS_PORTAL_STATE")
    if override:
        return Path(override)
    base = os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")
    return Path(base) / "nyxus" / "portal-state.json"


def load_state() -> dict:
    try:
        d = json.loads(state_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return d if isinstance(d, dict) else {}


def save_state(data: dict) -> None:
    try:
        p = state_path()
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(json.dumps(data, sort_keys=True), encoding="utf-8")
    except OSError:
        # Losing this marker costs one repeated notification. Taking the
        # watcher down over it would cost the feature.
        pass


# ── NetworkManager, read-only ────────────────────────────────────────────
#
# Gio rather than a `nmcli` subprocess: nmcli's human output is a localised
# string and this build ships an i18n shim, so parsing it would be a bug
# waiting for a translation. The D-Bus property is an integer in every
# language.

def _nm_proxy():
    """A read-only proxy onto NetworkManager, or None if it is not there."""
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio
    except (ImportError, ValueError):
        return None
    try:
        return Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
            NM_BUS, NM_PATH, NM_BUS, None)
    except Exception:
        return None


def _prop(proxy, name, default=None):
    try:
        v = proxy.get_cached_property(name)
        return default if v is None else v.unpack()
    except Exception:
        return default


def read_nm() -> dict | None:
    """Connectivity state, the check's URI, and whether the check is on.

    Returns None when NetworkManager cannot be reached at all, which is a
    different answer from "connectivity unknown" and is reported as such.
    """
    proxy = _nm_proxy()
    if proxy is None:
        return None
    state = _prop(proxy, "Connectivity", NM_CONNECTIVITY_UNKNOWN)
    return {
        "connectivity": int(state or 0),
        "state": STATE_WORDS.get(int(state or 0), "unknown"),
        "portal": int(state or 0) == NM_CONNECTIVITY_PORTAL,
        "check_enabled": bool(_prop(proxy, "ConnectivityCheckEnabled", False)),
        "check_available": bool(
            _prop(proxy, "ConnectivityCheckAvailable", False)),
        "check_uri": _prop(proxy, "ConnectivityCheckUri", "") or "",
    }


def active_connection_id(proxy=None) -> str:
    """A name for the network we are on, so 'told them once' means once PER
    network rather than once per machine. Best effort: an empty string is a
    fine answer and simply makes the marker coarser."""
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio
        p = proxy or _nm_proxy()
        if p is None:
            return ""
        for path in (_prop(p, "ActiveConnections", []) or []):
            ac = Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
                NM_BUS, path, NM_BUS + ".Connection.Active", None)
            if _prop(ac, "Default", False):
                return str(_prop(ac, "Id", "") or "")
    except Exception:
        pass
    return ""


# ── the sign-in page ─────────────────────────────────────────────────────

def open_signin(uri: str) -> bool:
    """Open the connectivity-check URL and let the portal hijack it.

    There is no API that hands out "the portal's login address" — the
    portal announces itself by INTERCEPTING an ordinary request, so the
    only reliable way to reach the login page is to make one. The URL used
    is NetworkManager's own check URI, read live off D-Bus, so this can
    never point somewhere the machine was not already contacting.
    """
    if not uri:
        return False
    exe = shutil.which("xdg-open") or shutil.which("chromium") \
        or shutil.which("firefox")
    if not exe:
        return False
    try:
        subprocess.Popen([exe, uri], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except OSError:
        return False


def notify_signin(uri: str, *, quiet: bool = False) -> str:
    """Raise the notice and return the key the person chose.

    ⛔ AN EMPTY ANSWER IS NOT A YES — the same rule nyxus-hemera's
       notify_ask() is built around. Dismissed, swiped away, no daemon
       running, process killed: all of them return "" and all of them open
       nothing. Silence is only ever allowed to do nothing here.
    """
    if quiet or not shutil.which("notify-send"):
        return ""
    cmd = ["notify-send", "--app-name", APP_NAME,
           "--urgency", "critical",
           "--icon", "network-wireless-acquiring",
           "-A", f"{PORTAL_ACTION_KEY}={PORTAL_ACTION_LABEL}",
           PORTAL_TITLE, PORTAL_BODY]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, check=False,
                           timeout=24 * 60 * 60)
    except (OSError, subprocess.SubprocessError):
        return ""
    answer = p.stdout.strip()
    if answer == PORTAL_ACTION_KEY:
        open_signin(uri)
    return answer


# ── the watch ────────────────────────────────────────────────────────────

def on_state(info: dict, *, quiet: bool = False) -> None:
    """React to one connectivity state. Idempotent by design.

    The marker is cleared as soon as we are no longer behind a portal, so
    the NEXT portal — a different hotel, or the same one after the session
    times out — is announced again. A marker that is only ever set turns a
    once-per-episode notice into a once-per-machine notice, which is the
    same "told you once in March" failure smartd's mail-to-root has.
    """
    st = load_state()
    conn = info.get("conn", "")
    key = f"portal:{conn}"
    if not info.get("portal"):
        if st.pop(key, None) is not None:
            save_state(st)
        return
    if st.get(key):
        return
    st[key] = int(time.time())
    save_state(st)
    notify_signin(info.get("check_uri", ""), quiet=quiet)


def watch(*, quiet: bool = False) -> int:
    """Follow NetworkManager's Connectivity property until killed.

    Signal-driven, not polled: PropertiesChanged wakes this process and
    nothing else does. An idle laptop on a healthy network wakes this code
    zero times an hour, which is the only budget a background watcher is
    entitled to.
    """
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
    except (ImportError, ValueError):
        print("nyxus-portal-watch: python-gobject is not available",
              file=sys.stderr)
        return 1
    proxy = _nm_proxy()
    if proxy is None:
        print("nyxus-portal-watch: NetworkManager is not on the system bus",
              file=sys.stderr)
        return 1

    def snapshot() -> dict:
        info = read_nm() or {}
        info["conn"] = active_connection_id()
        return info

    def changed(_p, changed_props, _inval):
        try:
            keys = changed_props.keys()
        except AttributeError:
            keys = []
        if "Connectivity" in keys or "ActiveConnections" in keys:
            on_state(snapshot(), quiet=quiet)

    proxy.connect("g-properties-changed", changed)
    # Act on the state we are ALREADY in. A laptop that resumes from
    # suspend inside a hotel is behind the portal before this process
    # starts, and a watcher that only reacts to transitions would sit there
    # knowing the answer and saying nothing.
    on_state(snapshot(), quiet=quiet)
    GLib.MainLoop().run()
    return 0


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    as_json = "--json" in args
    quiet = "--quiet" in args
    for a in args:
        if a not in ("--json", "--quiet", "--once", "--open"):
            print(f"nyxus-portal-watch: unknown option {a}", file=sys.stderr)
            return 2

    if "--open" in args:
        info = read_nm()
        if info is None:
            print("nyxus-portal-watch: NetworkManager is not reachable",
                  file=sys.stderr)
            return 1
        ok = open_signin(info["check_uri"])
        if as_json:
            print(json.dumps({"opened": ok, "uri": info["check_uri"]},
                             indent=2, sort_keys=True))
        elif not ok:
            print("nyxus-portal-watch: nothing here can open a web page",
                  file=sys.stderr)
        return 0 if ok else 1

    if "--once" in args or as_json:
        info = read_nm()
        if info is None:
            if as_json:
                print(json.dumps({"reachable": False,
                                  "note": "NetworkManager is not on the "
                                          "system bus"},
                                 indent=2, sort_keys=True))
            else:
                print("nyxus-portal-watch: NetworkManager is not reachable",
                      file=sys.stderr)
            return 1
        info["reachable"] = True
        info["conn"] = active_connection_id()
        if as_json:
            print(json.dumps(info, indent=2, sort_keys=True))
        else:
            print(f"{info['state']} (connectivity={info['connectivity']}, "
                  f"check={'on' if info['check_enabled'] else 'off'})")
        if "--once" in args:
            on_state(info, quiet=quiet)
        return 0

    return watch(quiet=quiet)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
