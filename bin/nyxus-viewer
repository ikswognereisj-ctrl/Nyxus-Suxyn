#!/usr/bin/env bash
# Nyxus Suxyn — raise glass Viewer. Never GTK nyxus_viewer.py.
set -u
if ! command -v qs >/dev/null 2>&1; then
  echo "Viewer needs the desktop shell (qs)." >&2
  exit 2
fi
if [[ -n "${1:-}" ]]; then
  out="$(qs ipc call viewer at "$1" 2>&1)" || true
else
  out="$(qs ipc call viewer engage 2>&1)" || true
fi
if [[ "${out}" == *"Target not found."* ]]; then
  out="$(qs ipc call nyxus viewer 2>&1)" || true
fi
if [[ "${out}" == *"Target not found."* ]]; then
  echo "Viewer is not in the running shell." >&2
  printf '%s\n' "${out}" >&2
  exit 2
fi
printf '%s\n' "${out}"
exit 0
